{
  "schema_version": 1,
  "repositories": [
    {
      "name": "open-resource-governance",
      "role": "hub",
      "visibility_stage": "public",
      "public_safe": true,
      "owns": ["system map", "public docs", "promotion kit"]
    },
    {
      "name": "resource-radar",
      "role": "resource-discovery",
      "visibility_stage": "private-source",
      "public_safe": "repo-dependent",
      "owns": ["discovery", "normalization", "scoring", "lifecycle", "reports"]
    },
    {
      "name": "agent-skills-curated",
      "role": "curated-skills-governance",
      "visibility_stage": "private-pre-public",
      "public_safe": "repo-dependent",
      "owns": ["reviewed Skill content", "provenance", "topology", "conflicts", "release manifests"]
    },
    {
      "name": "codex-user-config-template",
      "role": "configuration-template",
      "visibility_stage": "public",
      "public_safe": true,
      "owns": ["public-safe Codex configuration template", "placeholder examples", "private setup guidance"]
    },
    {
      "name": "codex-user-config",
      "role": "private-configuration-source",
      "visibility_stage": "private",
      "public_safe": false,
      "owns": ["real Codex configuration", "memory snapshots", "preferences", "local restore policy"]
    },
    {
      "name": "claude-user-config-template",
      "role": "configuration-template",
      "visibility_stage": "public",
      "public_safe": true,
      "owns": ["public-safe Claude Code configuration template", "placeholder examples", "private setup guidance"]
    },
    {
      "name": "claude-user-config",
      "role": "private-configuration-source",
      "visibility_stage": "private",
      "public_safe": false,
      "owns": ["real Claude Code configuration", "curated memory", "commands", "hooks", "local restore policy"]
    },
    {
      "name": "research-bookmarks-public",
      "role": "public-bookmark-projection",
      "visibility_stage": "public",
      "public_safe": true,
      "owns": ["public-safe source taxonomy", "structured public source catalog", "generated browser-importable HTML"]
    },
    {
      "name": "research-bookmarks",
      "role": "private-bookmark-source",
      "visibility_stage": "private",
      "public_safe": false,
      "owns": ["complete bookmark imports", "private overlays", "audit evidence", "declassification inputs"]
    }
  ]
}
